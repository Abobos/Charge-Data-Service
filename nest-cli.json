{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/graphql-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/graphql-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/graphql-service",
  "projects": {
    "graphql-service": {
      "type": "application",
      "root": "apps/graphql-service",
      "entryFile": "main",
      "sourceRoot": "apps/graphql-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/graphql-service/tsconfig.app.json"
      }
    },
    "task-service": {
      "type": "application",
      "root": "apps/task-service",
      "entryFile": "main",
      "sourceRoot": "apps/task-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/task-service/tsconfig.app.json"
      }
    },
    "dal": {
      "type": "library",
      "root": "libs/dal",
      "entryFile": "index",
      "sourceRoot": "libs/dal/src",
      "compilerOptions": {
        "tsConfigPath": "libs/dal/tsconfig.lib.json"
      }
    }
  }
}
